# Auto-generated local LLVM backups created by setup.sh
llvm/llvm-project_backup_*

# AFL++ fuzzing output
llvm/feli/afl_out/
llvm/feli/afl_out_plain/

# AFL++ compiled wrapper binaries (generated by fuzz.sh / afl-clang-fast)
llvm/feli/scripts/afl_fuzz_wrapper
llvm/feli/scripts/afl_fuzz_wrapper_plain

# Plain PUA binary compiled for fuzzing (generated by fuzz.sh -plain)
llvm/feli/outputs/pua_plain

# Compiled AFL reporter object (generated by instrument.sh -afl)
llvm/feli/temps/mm_afl_reporter.o

# Core dumps
core
