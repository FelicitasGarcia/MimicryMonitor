# Auto-generated local LLVM backups created by pipeline/setup.sh
llvm/llvm-project_backup_*

# All generated pipeline artifacts (IR, CFGs, monitors, renders, fuzzing output).
# Recreated by analyze.sh / the Java monitor / instrument.sh on every run.
work/

# Maven build output
monitor/target/

# Out-of-tree Mimicry pass build
instrumentation/build/

# Generated monitor action IR from the instrumentation pass
instrumentation/monitorAction.ll

# AFL++ compiled wrapper binaries (generated by fuzz.sh / afl-clang-fast)
pipeline/afl_fuzz_wrapper
pipeline/afl_fuzz_wrapper_plain

# Core dumps
core

# macOS metadata
**/.DS_Store

# Vestigial JS deps (renderer uses the dot CLI via graphviz-java)
node_modules/
