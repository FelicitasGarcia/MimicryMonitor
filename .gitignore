# Auto-generated local LLVM backups created by setup.sh
llvm/llvm-project_backup_*

# AFL++ fuzzing output
llvm/feli/afl_out/
llvm/feli/afl_out_plain/

# AFL++ compiled wrapper binaries (generated by fuzz.sh / afl-clang-fast)
llvm/feli/scripts/afl_fuzz_wrapper
llvm/feli/scripts/afl_fuzz_wrapper_plain

# Plain PUA binary compiled for fuzzing (generated by fuzz.sh -plain)
llvm/feli/outputs/pua_plain

# Compiled AFL reporter object (generated by instrument.sh -afl)
llvm/feli/temps/mm_afl_reporter.o

# Core dumps
core

# macOS metadata
**/.DS_Store

# Generated LLVM IR in temps (rebuilt on every instrumentation run)
llvm/feli/temps/*.ll

# Generated monitor action IR from pass
llvm/feli/passes/monitorAction.ll

# Test result files
llvm/feli/outputs/results_*

# Generated output files — folders kept via .gitkeep
exampleFiles/dots/llvm/*
!exampleFiles/dots/llvm/.gitkeep
exampleFiles/dots/llvmBasedResults/*
!exampleFiles/dots/llvmBasedResults/.gitkeep
exampleFiles/renders/llvm/*
!exampleFiles/renders/llvm/.gitkeep
exampleFiles/renders/llvmBasedResults/*
!exampleFiles/renders/llvmBasedResults/.gitkeep

llvm/feli/cfgs/*
!llvm/feli/cfgs/.gitkeep

llvm/feli/outputs/*
!llvm/feli/outputs/.gitkeep

llvm/feli/temps/*
!llvm/feli/temps/.gitkeep
