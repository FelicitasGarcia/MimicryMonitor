#!/bin/bash
# Convenience launcher: runs stopstats.py with the bundled venv interpreter.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$DIR/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "venv not found. Create it once:"
  echo "  python3 -m venv \"$DIR/.venv\" && \"$DIR/.venv/bin/pip\" install matplotlib"
  exit 1
fi
exec "$PY" "$DIR/stopstats.py" "$@"
