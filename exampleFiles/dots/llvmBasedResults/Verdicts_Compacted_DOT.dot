digraph Verdicts_Compacted {
  rankdir=TB; // Top to bottom layout
  rank=min;
  nodesep=0.5; // Increase node separation
  ranksep=0.8; // Increase rank separation
edge [curvature=0.3];  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  -2 [label="V", style=filled, fillcolor="darkolivegreen3", shape=diamond, margin="0.15,0.15"];
  -1 [label="IV", style=filled, fillcolor="lightcoral", shape=diamond, margin="0.15,0.15"];
  360 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  126 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  198 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  275 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  50 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  90 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  0 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  10 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];

  0 -> 10 [label="Entry", id=16, arrowhead=normal, penwidth=1.2];
  10 -> 50 [label="if (argc \< 2)\\l?", id=16, arrowhead=normal, penwidth=1.2];
  50 -> -2 [label="if (argc \< 2)\\l: then", id=16, arrowhead=vee, penwidth=1.2];
  50 -> 90 [label="if (argc \< 2)\\l: else", id=16, arrowhead=dot, penwidth=1.2];
  90 -> 126 [label="int n = atoi(argv[1]);\\l", id=21, arrowhead=normal, penwidth=1.2];
  126 -> 198 [label="if (n \< 0)\\l?", id=23, arrowhead=normal, penwidth=1.2];
  198 -> 275 [label="if (n \< 0)\\l: else", id=23, arrowhead=dot, penwidth=1.2];
  198 -> -2 [label="if (n \< 0)\\l: then", id=23, arrowhead=vee, penwidth=1.2];
  275 -> 360 [label="if (n == 0)\\l?", id=25, arrowhead=normal, penwidth=1.2];
  360 -> -2 [label="if (n == 0)\\l: else", id=25, arrowhead=dot, penwidth=1.2];
  360 -> -1 [label="if (n == 0)\\l: then", id=25, arrowhead=vee, penwidth=1.2];
