  0 -> 0 [label="result = 1; /* BUG: should be ...", id=28, arrowhead=normal, penwidth=1.2];
  1 -> 0 [label="result = 1; /* BUG: should be ...", id=28, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="result = 2;\\l", id=30, arrowhead=normal, penwidth=1.2];
  1 -> 0 [label="result = 2;\\l", id=30, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="printf('%d\\n', result);\\l", id=31, arrowhead=normal, penwidth=1.2];
