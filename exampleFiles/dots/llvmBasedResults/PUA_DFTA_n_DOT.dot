digraph DFTA {
  rankdir=TB; // Top to bottom layout
  rank=min;
  nodesep=0.5; // Increase node separation
  ranksep=0.8; // Increase rank separation
edge [curvature=0.3];  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  0 [label="valid", style=filled, fillcolor="darkolivegreen3", shape=diamond, margin="0.15,0.15"];
  1 [label="invalid", style=filled, fillcolor="coral2", shape=diamond, margin="0.15,0.15"];

  0 -> 0 [label="int n = atoi(argv[1]);\\l", id=20, arrowhead=normal, penwidth=1.2];
  1 -> 0 [label="int n = atoi(argv[1]);\\l", id=20, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n \< 0)         result = -1...", id=22, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n \< 0)         result = -1...: then", id=22, arrowhead=vee, penwidth=1.2];
  0 -> 0 [label="if (n \< 0)         result = -1...: else", id=22, arrowhead=dot, penwidth=1.2];
  0 -> 0 [label="if (n \< 0)         result = -1...", id=22, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n == 0)   result =  0;\\l?", id=23, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n == 0)   result =  0;\\l: ...: then", id=23, arrowhead=vee, penwidth=1.2];
  0 -> 0 [label="if (n == 0)   result =  0;\\l: ...: else", id=23, arrowhead=dot, penwidth=1.2];
  0 -> 0 [label="if (n == 0)   result =  0;\\l", id=23, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n \< 127)  result =  1;  /*...", id=24, arrowhead=normal, penwidth=1.2];
  0 -> 0 [label="if (n \< 127)  result =  1;  /*...: then", id=24, arrowhead=vee, penwidth=1.2];
  0 -> 0 [label="if (n \< 127)  result =  1;  /*...: else", id=24, arrowhead=dot, penwidth=1.2];
  0 -> 0 [label="1: result ! PUA", id=24, arrowhead=normal, penwidth=1.2];
}