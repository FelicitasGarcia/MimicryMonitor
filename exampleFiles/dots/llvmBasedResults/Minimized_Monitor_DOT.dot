digraph Minimized_Monitor {
  rankdir=TB; // Top to bottom layout
  rank=min;
  nodesep=0.5; // Increase node separation
  ranksep=0.8; // Increase rank separation
edge [curvature=0.3];  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  4 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  1 [label="NV", style=filled, fillcolor="lightgoldenrod2", shape=diamond, margin="0.15,0.15"];
  -2 [label="V", style=filled, fillcolor="darkolivegreen3", shape=diamond, margin="0.15,0.15"];
  -1 [label="IV", style=filled, fillcolor="lightcoral", shape=diamond, margin="0.15,0.15"];
  2 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  3 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  6 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  10 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  7 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];
  8 [label="NV", style=filled, fillcolor="lightcyan2", shape=ellipse, margin="0.15,0.15"];

  1 -> 2 [label="int P = argv[1] ? atoi(argv[1]...", id=0, arrowhead=normal, penwidth=1.2];
  2 -> 3 [label="int P = argv[1] ? atoi(argv[1]...: else", id=1, arrowhead=dot, penwidth=1.2];
  2 -> 3 [label="int P = argv[1] ? atoi(argv[1]...: then", id=2, arrowhead=vee, penwidth=1.2];
  3 -> 4 [label="if (Cond0(P))\\l?", id=3, arrowhead=normal, penwidth=1.2];
  4 -> -1 [label="if (Cond0(P))\\l: then", id=4, arrowhead=vee, penwidth=1.2];
  4 -> 6 [label="if (Cond0(P))\\l: else", id=5, arrowhead=dot, penwidth=1.2];
  6 -> 7 [label="if (Cond1(P))\\l?", id=6, arrowhead=normal, penwidth=1.2];
  7 -> 8 [label="if (Cond1(P))\\l: then", id=7, arrowhead=vee, penwidth=1.2];
  7 -> -2 [label="if (Cond1(P))\\l: else", id=8, arrowhead=dot, penwidth=1.2];
  8 -> 10 [label="if (Cond(A))\\l?", id=9, arrowhead=normal, penwidth=1.2];
  10 -> -2 [label="if (Cond(A))\\l: then", id=10, arrowhead=vee, penwidth=1.2];
  10 -> -1 [label="if (Cond(A))\\l: else", id=11, arrowhead=dot, penwidth=1.2];
}