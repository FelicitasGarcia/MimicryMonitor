digraph LLVMOG {
6 [shape = record, label="6result = 0;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2printf('%d\\n', result);\\l | Reads: [result ; .str.1] \l Writes: [.str.1]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3return 0;\\l | ", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
4 [shape = record, label="4int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (n \< 127)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 1; /* BUG: should be 128 — off-by-one regression */\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; __stderrp ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9return 1;\\l | ", style=filled, fillcolor="papayawhip"];
2 -> 3 [label="", id= 0];
4 -> 5 [label="", id= 1];
8 -> 9 [label="", id= 2];
11 -> 8 [label="T", id= 3];
11 -> 4 [label="F", id= 4];
5 -> 1 [label="T", id= 5];
5 -> 0 [label="F", id= 6];
1 -> 2 [label="", id= 7];
0 -> 6 [label="T", id= 8];
0 -> 10 [label="F", id= 9];
6 -> 2 [label="", id= 10];
