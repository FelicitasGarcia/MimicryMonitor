digraph LLVMOG {
4 [shape = record, label="4if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7result = 0;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6return 1;\\l | ", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
3 -> 4 [label="", id= 0];
5 -> 6 [label="", id= 1];
9 -> 5 [label="T", id= 2];
9 -> 3 [label="F", id= 3];
4 -> 0 [label="T", id= 4];
4 -> 1 [label="F", id= 5];
0 -> 2 [label="", id= 6];
1 -> 7 [label="T", id= 7];
1 -> 8 [label="F", id= 8];
7 -> 2 [label="", id= 9];
8 -> 10 [label="T", id= 10];
8 -> 11 [label="F", id= 11];
10 -> 2 [label="", id= 12];
11 -> 2 [label="", id= 13];
}