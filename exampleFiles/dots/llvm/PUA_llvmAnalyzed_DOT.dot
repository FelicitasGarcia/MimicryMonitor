digraph LLVMOG {
8 [shape = record, label="8result = 0;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
4 [shape = record, label="4return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1return 1;\\l | ", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
0 -> 1 [label="", id= 0];
6 -> 7 [label="", id= 1];
10 -> 0 [label="T", id= 2];
10 -> 6 [label="F", id= 3];
7 -> 2 [label="T", id= 4];
7 -> 3 [label="F", id= 5];
2 -> 4 [label="", id= 6];
3 -> 8 [label="T", id= 7];
3 -> 9 [label="F", id= 8];
8 -> 4 [label="", id= 9];
9 -> 11 [label="T", id= 10];
9 -> 5 [label="F", id= 11];
11 -> 4 [label="", id= 12];
5 -> 4 [label="", id= 13];
}