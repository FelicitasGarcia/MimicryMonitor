digraph LLVMOG {
9 [shape = record, label="9if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
4 [shape = record, label="4return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6int result = 10;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3return 1;\\l | ", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
2 -> 3 [label="", id= 0];
5 -> 6 [label="", id= 1];
6 -> 7 [label="", id= 2];
10 -> 2 [label="T", id= 3];
10 -> 5 [label="F", id= 4];
7 -> 0 [label="T", id= 5];
7 -> 1 [label="F", id= 6];
0 -> 4 [label="", id= 7];
1 -> 8 [label="T", id= 8];
1 -> 9 [label="F", id= 9];
8 -> 4 [label="", id= 10];
9 -> 11 [label="T", id= 11];
9 -> 12 [label="F", id= 12];
11 -> 4 [label="", id= 13];
12 -> 4 [label="", id= 14];
}