digraph LLVMOG {
4 [shape = record, label="4printf('%d\\n', result);\\l | Reads: [result ; .str.1] \l Writes: [.str.1]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2result = -1; /* negative              */\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5return 0;\\l | ", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; __stderrp ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9result = 0; /* zero                  */\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 1; /* small positive [1,127] */\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8result = 2; /* large positive [128,∞) */\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7return 1;\\l | ", style=filled, fillcolor="papayawhip"];
0 -> 1 [label="", id= 0];
4 -> 5 [label="", id= 1];
6 -> 7 [label="", id= 2];
11 -> 6 [label="T", id= 3];
11 -> 0 [label="F", id= 4];
1 -> 2 [label="T", id= 5];
1 -> 3 [label="F", id= 6];
2 -> 4 [label="", id= 7];
3 -> 9 [label="T", id= 8];
3 -> 10 [label="F", id= 9];
9 -> 4 [label="", id= 10];
10 -> 12 [label="T", id= 11];
10 -> 8 [label="F", id= 12];
12 -> 4 [label="", id= 13];
8 -> 4 [label="", id= 14];
}