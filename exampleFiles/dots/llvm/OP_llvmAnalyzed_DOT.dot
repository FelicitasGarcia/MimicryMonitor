digraph LLVMOG {
4 [shape = record, label="4if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3return 1;\\l | ", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7int result = 10;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
2 -> 3 [label="", id= 0];
6 -> 7 [label="", id= 1];
7 -> 8 [label="", id= 2];
}