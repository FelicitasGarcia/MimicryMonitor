5 [shape = record, label="5if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
