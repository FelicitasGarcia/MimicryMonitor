digraph LLVMOG {
2 [shape = record, label="2if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7int result = 10;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
1 [shape = record, label="1result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
4 [shape = record, label="4fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5return 1;\\l | ", style=filled, fillcolor="papayawhip"];
4 -> 5 [label="", id= 0];
6 -> 7 [label="", id= 1];
7 -> 8 [label="", id= 2];
11 -> 4 [label="T", id= 3];
11 -> 6 [label="F", id= 4];
8 -> 0 [label="T", id= 5];
8 -> 2 [label="F", id= 6];
0 -> 3 [label="", id= 7];
2 -> 9 [label="T", id= 8];
2 -> 10 [label="F", id= 9];
9 -> 3 [label="", id= 10];
10 -> 12 [label="T", id= 11];
10 -> 1 [label="F", id= 12];
12 -> 3 [label="", id= 13];
1 -> 3 [label="", id= 14];
}