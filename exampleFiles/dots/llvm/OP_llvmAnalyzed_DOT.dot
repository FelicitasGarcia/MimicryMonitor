digraph LLVMOG {
1 [shape = record, label="1result = -1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
8 [shape = record, label="8if (argc \< 2)\\l | Reads: [argc]", style=filled, fillcolor="papayawhip"];
2 [shape = record, label="2return 10 / result;\\l | Reads: [result]", style=filled, fillcolor="papayawhip"];
0 [shape = record, label="0if (n == 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
6 [shape = record, label="6result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
3 [shape = record, label="3int n = atoi(argv[1]);\\l | Reads: [argv] \l Writes: [n]", style=filled, fillcolor="papayawhip"];
4 [shape = record, label="4int result = 10;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
5 [shape = record, label="5if (n \< 0)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
11 [shape = record, label="11return 1;\\l | ", style=filled, fillcolor="papayawhip"];
7 [shape = record, label="7if (n \< 128)\\l | Reads: [n]", style=filled, fillcolor="papayawhip"];
9 [shape = record, label="9result = 1;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
10 [shape = record, label="10fprintf(stderr, 'usage: %s \<integer\>\\n', argv[0]);\\l | Reads: [.str ; stderr ; argv] \l Writes: [.str]", style=filled, fillcolor="papayawhip"];
12 [shape = record, label="12result = 2;\\l | Writes: [result]", style=filled, fillcolor="papayawhip"];
3 -> 4 [label="", id= 0];
4 -> 5 [label="", id= 1];
10 -> 11 [label="", id= 2];
}